@startuml architecture
title Participation Trace — System Architecture
skinparam shadowing false
skinparam defaultFontName Arial
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #555555
  RoundCorner 12
}
skinparam ArrowColor #444444
top to bottom direction

actor "Citizens, Clerk's Office,\nmoderators, administrators\n(web browser)" as Users

rectangle "1. Client layer: React 18 + TypeScript single-page app (Vite, Netlify)" as Client #F7F5F0 {
  rectangle "Public and citizen pages\nbills · submit / edit view · my receipts\nverify hash chain · trace to House and Act · Act reader" as PublicPages
  rectangle "Staff pages\nmatch review · reported content\nbill, call and report ingestion · administration" as StaffPages
  rectangle "Service worker + IndexedDB\noffline drafts · pages load their code on demand" as Offline
}

rectangle "2. API and authorisation layer: FastAPI on Python 3.11 (Render, Docker)" as Api #F7F5F0 {
  rectangle "REST API /api/v1 (65 endpoints)\nPydantic validation · gzip JSON responses" as Rest
  rectangle "JWT sessions · argon2id passwords\nrole and committee-scope checks\nrate limits · sign-in lockout" as Security
}

rectangle "3. Domain services" as Services #F2F7F2 {
  rectangle "Receipt service\nSHA-256 hash chain\nversions, verification" as ReceiptSvc
  rectangle "Participation rules\nwhen a bill accepts views\nsubmission stages · committee assignment" as Rules
  rectangle "Notification service\nEnglish / Kiswahili updates" as NotifySvc
  rectangle "Ingestion service\npdftotext, Tesseract OCR fallback\nentry parser" as IngestSvc
  rectangle "Linking service\nGemini proposal (text-similarity\nfallback) → human review" as LinkSvc
  rectangle "Report worker\ninside the API, every 10 min" as Worker
  rectangle "Tracing services\nreport analysis (who said what)\nHouse trace · Act trace\nevidence checked against the source" as TraceSvc
}

rectangle "4. Data and audit layer" as Data #F7F5F0 {
  database "PostgreSQL (Neon)\n18 tables · append-only triggers on\nparticipation_receipts and audit_log" as Db
  storage "File storage (Render disk)\ncommittee reports, memoranda, Acts\nstored with SHA-256" as Files
}

rectangle "Legislation sync\nGitHub Actions, nightly 02:00 UTC\nbills, stages, calls, reports, county Acts" as Sync #F5F3FA
rectangle "Trace pipeline (run locally)\nOCR, analyse_reports, trace_house,\ntrace_acts, act_library\n→ trace_bundle export / import" as Pipeline #F5F3FA

cloud "Google Gemini API\nmatch proposals · report analysis\nHouse and Act checks" as Gemini
cloud "Official sources\nparliament.go.ke\nnairobiassembly.go.ke\ntransnzoiaassembly.go.ke\nkenyalaw.org (listing only)" as Sources
cloud "Mzalendo\nHansard copy · bill texts" as Mzalendo

Users --> Client
Client --> Api : HTTPS / JSON
Api --> Services
Services --> Data : SQLAlchemy (async)\nAlembic migrations

LinkSvc --> Gemini
TraceSvc --> Gemini
NotifySvc ..> Gemini : optional
IngestSvc --> Sources : linked report PDFs
Sync --> Sources : bills, stages,\ncalls, reports, Acts
Sync --> Mzalendo : bill texts
Sync --> Db : upserts
Pipeline --> TraceSvc
Pipeline --> Mzalendo : Hansard
Pipeline --> Db : imports the trace\nby official ids

PublicPages -[hidden]right- StaffPages
StaffPages -[hidden]right- Offline
Rest -[hidden]right- Security
ReceiptSvc -[hidden]right- Rules
Rules -[hidden]right- NotifySvc
IngestSvc -[hidden]right- LinkSvc
LinkSvc -[hidden]right- Worker
Worker -[hidden]right- TraceSvc
ReceiptSvc -[hidden]down- IngestSvc
Db -[hidden]right- Files
Sync -[hidden]right- Pipeline
@enduml
