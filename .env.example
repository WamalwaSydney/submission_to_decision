# Frontend build-time API URL
VITE_API_URL=http://localhost:8000/api/v1

# Backend-only values: configure these in Render, never in Netlify
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/participation_platform?ssl=disable
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
